{
  "name": "@terminal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./heartbeat": "./src/heartbeat.ts",
    "./market": "./src/market.ts",
    "./intelligence": "./src/intelligence.ts",
    "./tokens": "./src/tokens.ts",
    "./wallets": "./src/wallets.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@terminal/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
