{
  admin off
  servers {
    max_header_size 4KiB
    timeouts {
      read_header 10s
      read_body 30s
      idle 60s
    }
  }
}
(public_tls) {
}
(local_tls) {
  tls internal
}
{$APP_ORIGIN} {
  import {$TLS_PROFILE:public_tls}
  basic_auth {
    {$ACCESS_USER} {$ACCESS_HASH}
  }
  request_body {
    max_size 32KB
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  encode gzip
  reverse_proxy web:3000 {
    header_up -Authorization
    header_up -Proxy-Authorization
  }
}
# Loopback within the container only; no bypass listener on the Docker network.
http://127.0.0.1:8081 {
  bind 127.0.0.1
  @health path /health
  handle @health {
    reverse_proxy web:3000
  }
  handle {
    respond 404
  }
}
