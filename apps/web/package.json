{
  "name": "@terminal/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@terminal/db": "workspace:*",
    "@terminal/domain": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.4"
  }
}
